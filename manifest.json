{
  "manifest_version": 3,
  "name": "抖音逐帧控制",
  "version": "1.0",
  "description": "为抖音视频播放器添加逐帧前进和后退功能",
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音逐帧控制"
  },
  "content_scripts": [
    {
      "matches": ["https://*.douyin.com/*", "https://*.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}